# ── Telegram ──────────────────────────────────────────────
# @BotFather bergan token
BOT_TOKEN=123456789:AAExampleExampleExampleExample
# Adminlarning Telegram ID lari, vergul bilan
ADMIN_IDS=111111111,222222222
# Yopiq video kanal ID si: videolar shu yerga tashlanadi, bot ularni o'zi qo'shadi.
# Bot kanalda "Post messages" huquqli admin bo'lishi kerak.
BACKUP_CHANNEL_ID=-1001234567890

# ── Webhook ───────────────────────────────────────────────
# Serverda to'ldiriladi. Bo'sh qoldirilsa bot polling rejimida ishlaydi (lokal sinov uchun).
WEBHOOK_URL=https://bot.example.uz/webhook
# Faqat lotin harflari, raqamlar, _ va - (1-256 belgi)
WEBHOOK_SECRET=uzun-tasodifiy-satr
# Caddy HTTPS sertifikat oladigan domen (WEBHOOK_URL dagi bilan bir xil)
DOMAIN=bot.example.uz

# ── Ma'lumotlar bazasi ────────────────────────────────────
POSTGRES_DB=videobot
POSTGRES_USER=videobot
# Faqat lotin harflari va raqamlar
POSTGRES_PASSWORD=KuchliParol123
# Docker Compose bu qiymatni yuqoridagilardan o'zi yig'adi.
# Faqat botni Docker'siz ishga tushirganda kerak.
DATABASE_URL=postgresql+asyncpg://videobot:KuchliParol123@localhost:5432/videobot

# ── Qo'shimcha ────────────────────────────────────────────
# true bo'lsa mijoz videoni forward qila olmaydi va saqlay olmaydi
PROTECT_CONTENT=false
# Bo'limlar necha darajagacha ichma-ich bo'lishi mumkin
MAX_DEPTH=5
# Kunlik baza zaxirasi (pg_dump) — yopiq kanalga yuboriladi
DB_BACKUP_ENABLED=true
DB_BACKUP_HOUR=3
TIMEZONE=Asia/Tashkent
LOG_LEVEL=INFO
